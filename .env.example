# Copy this to .env and fill in your values
# Never commit .env to git

# ── Anthropic (get from console.anthropic.com) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── LangSmith tracing (langsmith.com — free tier) ─────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=incident-autopilot

# ── Pinecone (app.pinecone.io — free tier) ─────────────────────────────────
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=incident-logs

# ── Local services (these match docker-compose defaults) ───────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TIMESCALE_URL=postgresql://autopilot:autopilot@localhost:5432/incidents
REDIS_URL=redis://localhost:6379

# ── Agent settings ─────────────────────────────────────────────────────────
AGENT_MODEL=claude-haiku-20240307   # cheap during dev
AGENT_MAX_ITERATIONS=10             # safety guard — never remove this
AGENT_TEMPERATURE=0

# ── Slack (optional — set up in week 6) ────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_INCIDENT_CHANNEL=#incidents

# ── AWS (set up in week 6-7) ───────────────────────────────────────────────
AWS_REGION=us-east-1
S3_POSTMORTEM_BUCKET=incident-autopilot-postmortems
