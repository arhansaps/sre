# Copy this to .env and fill in your values


# ── AWS Bedrock ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_BASE_URL=https://bedrock-mantle.eu-north-1.api.aws/v1
BEDROCK_REGION=eu-north-1
BEDROCK_PROJECT=proj_wojmbnc5igbvv3r7ggfb

# ── LangSmith (disable if you don't have an API key) ──────────────────────────
LANGCHAIN_TRACING_V2=false

# ── Pinecone (app.pinecone.io — free tier) ─────────────────────────────────
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=incident-logs

# ── Local services (these match docker-compose defaults) ───────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TIMESCALE_URL=postgresql://autopilot:autopilot@localhost:5432/incidents
REDIS_URL=redis://localhost:6379

# ── Pipeline ─────────────────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
KAFKA_TOPIC_RAW=incidents.raw
KAFKA_TOPIC_NORMALISED=incidents.normalised
KAFKA_TOPIC_RESOLVED=incidents.resolved
KAFKA_CONSUMER_GROUP=incident-pipeline
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Agent settings ─────────────────────────────────────────────────────────
AGENT_MODEL=openai.gpt-oss-120b
AGENT_MAX_ITERATIONS=10             # safety guard — never remove this
AGENT_TEMPERATURE=0

# ── Slack  ────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_INCIDENT_CHANNEL=#incidents

# ── AWS  ───────────────────────────────────────────────
AWS_REGION=us-east-1
S3_POSTMORTEM_BUCKET=incident-autopilot-postmortems
